{
  "name": "supportpro",
  "version": "1.0.0",
  "description": "Backend server for SupportPro",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./dist/app.js",
    "start:build": "npm run build && npm start",
    "dev": "npx nodemon",
    "dev:full": "docker compose up -d && npx nodemon",
    "build": "rimraf ./dist && tsc",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down --remove-orphans",
    "docker:drop": "docker compose down -v --remove-orphans",
    "docs:generate": "npx ts-node generate-swagger.ts",
    "seed:roles": "npx ts-node src/scripts/seedRoles.ts",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [],
  "author": "ojokukufolahanmi@gmail.com",
  "license": "ISC",
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@testcontainers/postgresql": "^12.0.3",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.8",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "google-libphonenumber": "^3.2.42",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "joi": "^17.12.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.45.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "testcontainers": "^12.0.3",
    "typeorm": "^1.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.19",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.1",
