{
  "name": "supportpro",
  "version": "1.0.0",
  "description": "Backend server for Auxhr",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "tar": "^7.5.19",
    "glob": "^11.0.3",
    "minimatch": "^10.1.1",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.8",
    "@grpc/grpc-js": "^1.14.5",
    "qs": "^6.16.0",
    "@xmldom/xmldom": "^0.8.15",
    "ip-address": "^10.7.2",
    "undici": "^8.11.2",
    "uuid": "^11.1.1",
    "js-yaml": "^4.3.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    }
  },
  "scripts": {
    "start": "node ./dist/app.js",
    "start:build": "npm run build && npm start",
    "dev": "node --watch-path=src ./node_modules/.bin/ts-node --project tsconfig.dev.json ./src/app.ts",
    "dev:full": "docker compose up -d --wait postgres pgbouncer && npm run migration:run && npm run dev",
    "build": "rimraf ./dist && tsc && mkdir -p dist/config && cp src/config/pricing.yaml dist/config/pricing.yaml",
    "docker:up": "docker compose up -d",
    "docker:drop": "docker compose down -v --remove-orphans",
    "docs:generate": "npx ts-node generate-swagger.ts",
    "cleanup:notifications": "npx ts-node src/scripts/cleanupNotifications.ts",
    "recompute:ranks": "npx ts-node src/scripts/recomputeApplicationRanks.ts",
    "backfill:verdicts": "npx ts-node src/scripts/backfillMatchVerdicts.ts",
    "seed": "TS_NODE_PROJECT=tsconfig.dev.json node -r dotenv/config ./node_modules/.bin/ts-node src/scripts/seed.ts",
    "plans:sync": "TS_NODE_PROJECT=tsconfig.dev.json node -r dotenv/config ./node_modules/.bin/ts-node src/scripts/syncPlans.ts",
    "seed:admin": "TS_NODE_PROJECT=tsconfig.dev.json node -r dotenv/config ./node_modules/.bin/ts-node src/scripts/seedAdmin.ts",
    "migration:generate": "TS_NODE_PROJECT=tsconfig.dev.json node -r dotenv/config ./node_modules/.bin/typeorm-ts-node-commonjs migration:generate -d src/database/dataSource.ts",
    "migration:run": "TS_NODE_PROJECT=tsconfig.dev.json node -r dotenv/config ./node_modules/.bin/typeorm-ts-node-commonjs migration:run -d src/database/dataSource.ts",
    "migration:revert": "TS_NODE_PROJECT=tsconfig.dev.json node -r dotenv/config ./node_modules/.bin/typeorm-ts-node-commonjs migration:revert -d src/database/dataSource.ts",
    "migrate:prod": "node ./dist/scripts/migrate.js",
    "migration:check": "TS_NODE_PROJECT=tsconfig.dev.json node -r dotenv/config ./node_modules/.bin/ts-node src/scripts/checkMigrationDrift.ts",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [],
  "author": "ojokukufolahanmi@gmail.com",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@testcontainers/postgresql": "^12.0.3",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "google-libphonenumber": "^3.2.42",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "joi": "^17.12.1",
    "js-yaml": "^4.3.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "openai": "^4.45.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.25.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "testcontainers": "^12.0.3",
    "typeorm": "^1.0.0",
    "uuid": "^11.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.19",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}
