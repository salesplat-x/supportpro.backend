# PostgreSQL (required)
PG_HOST=
PG_PORT=5432
PG_DB=supportpro
PG_USER=postgres
PG_PASSWORD=

# App (required)
PORT=3000
JWT_SECRET=
SALT_ROUNDS=10
# Comma-separated list of allowed frontend origins for CORS (also used as the Paystack callback URL — first value)
FRONTEND_CALLBACK_URL=

# Paystack (required for payments)
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WHITELISTED_IPS=

# OpenAI (required for AI features)
OPENAI_API_KEY=

# Cloudinary (required for file uploads)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Brevo / Sendinblue (required for emails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Single admin account (required by `npm run seed:admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
