# PostgreSQL (required)
PG_HOST=
PG_PORT=5432
PG_DB=supportpro
PG_USER=postgres
PG_PASSWORD=

# App (required)
PORT=3000
JWT_SECRET=
SALT_ROUNDS=10
# Comma-separated list of allowed frontend origins for CORS.
# The first value is the public site origin (Paystack callback becomes {origin}/payment/verify).
FRONTEND_CALLBACK_URL=http://localhost:5173

# Paystack
# dummy = local checkout with no Paystack account (default). paystack = real API (test or live keys).
PAYSTACK_MODE=dummy
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
# Optional. Comma-separated IPs; leave empty to rely on HMAC only (recommended).
PAYSTACK_WHITELISTED_IPS=
# Optional. Recurring plan codes from the Paystack dashboard (live/test mode).
PAYSTACK_PLAN_CODE_PAID_MONTHLY=
PAYSTACK_PLAN_CODE_PAID_ANNUALLY=

# OpenAI (required for AI features)
OPENAI_API_KEY=

# Resend (required for emails)
# Use a sender address on a domain verified in Resend (SPF, DKIM, DMARC).
# Example: RESEND_SENDER_EMAIL=noreply@auxhr.com
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=

# Single admin account (required by `npm run seed:admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
